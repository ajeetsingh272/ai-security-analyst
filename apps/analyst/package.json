{
  "name": "@sentinel/analyst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI analyst worker: investigation loop and grounding validator",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentinel/db": "workspace:*",
    "@sentinel/observability": "workspace:*",
    "@sentinel/schema": "workspace:*",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
