# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# The dashboard app's own origin — apps/api redirects here after an
# OAuth callback (P6-04's M365 connect flow), never to its own origin.
APP_BASE_URL=http://localhost:3000

# ─── Postgres (control plane: tenants, cases, approvals, audit) ──────────────
POSTGRES_URL=postgres://sentinel:sentinel@localhost:5434/sentinel
POSTGRES_MAX_CONNECTIONS=20

# ─── ClickHouse (event store) ────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sentinel

# ─── Redpanda / Kafka ────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_RAW=events.raw
KAFKA_TOPIC_NORMALIZED=events.normalized
KAFKA_TOPIC_SIGNALS=signals
KAFKA_TOPIC_CASES=cases
KAFKA_CONSUMER_GROUP=sentinel

# ─── Redis / Valkey ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (raw log archive, cold tier) ─────────────────────────────
# Dev uses SeaweedFS, which speaks the S3 API. Production uses real S3.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=sentinel-archive
S3_ACCESS_KEY_ID=sentineldev
S3_SECRET_ACCESS_KEY=sentineldev
S3_REGION=ap-south-1

# ─── Anthropic (AI analyst) ──────────────────────────────────────────────────
# Triage model: cheap, high volume. Investigation model: deep reasoning.
ANTHROPIC_API_KEY=
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_INVESTIGATION_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192
AI_GROUNDING_STRICT=true

# ─── Connector OAuth (customer tenants grant these) ──────────────────────────
# P6-04: these names must match apps/api/src/routes/m365-connector.ts's own
# m365OAuthConfigFromEnv() exactly (M365_*, not MS_GRAPH_*, which this file
# used to say — a pre-existing mismatch that would have left the connector
# silently "not configured" for anyone who filled these in as written).
# The redirect URI points at the API's own real origin (its default dev
# port), never the dashboard's — the callback handler runs in apps/api's
# own process and redirects the browser into the dashboard itself once done.
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=http://localhost:4000/connectors/m365/callback
# P7-01: GOOGLE_REDIRECT_URI corrected to the same shape as M365_REDIRECT_URI
# above (the API's own real origin/port, path routes/google-connector.ts
# actually registers) — this placeholder previously pointed at the
# dashboard's port under a different path/slug ("gws") that no route in
# this codebase implements, the exact kind of mismatch the M365 comment
# above already warns about.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/connectors/google/callback

# ─── Notification channels ───────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/connectors/slack/callback
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_ADDRESS=alerts@sentinel.example
RESEND_DOMAIN_ID=

# ─── Security ────────────────────────────────────────────────────────────────
# 32-byte base64 key used to envelope-encrypt per-tenant connector credentials.
TENANT_KEK_BASE64=
# Signs time-limited one-tap approval tokens delivered over WhatsApp/Slack.
APPROVAL_TOKEN_SECRET=
# Set only during a rotation's overlap window (docs/runbooks/approval-token-secret-rotation.md)
# — the SECRET BEING REPLACED, never a brand new one. Remove once the overlap ends.
APPROVAL_TOKEN_SECRET_PREVIOUS=
SESSION_SECRET=

# ─── Threat intelligence ─────────────────────────────────────────────────────
ABUSEIPDB_API_KEY=
OTX_API_KEY=
MAXMIND_LICENSE_KEY=
