# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000

# ─── Postgres (control plane: tenants, cases, approvals, audit) ──────────────
POSTGRES_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
POSTGRES_MAX_CONNECTIONS=20

# ─── ClickHouse (event store) ────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sentinel

# ─── Redpanda / Kafka ────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_RAW=events.raw
KAFKA_TOPIC_NORMALIZED=events.normalized
KAFKA_TOPIC_SIGNALS=signals
KAFKA_TOPIC_CASES=cases
KAFKA_CONSUMER_GROUP=sentinel

# ─── Redis / Valkey ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (raw log archive, cold tier) ─────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sentinel-archive
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=ap-south-1

# ─── Anthropic (AI analyst) ──────────────────────────────────────────────────
# Triage model: cheap, high volume. Investigation model: deep reasoning.
ANTHROPIC_API_KEY=
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_INVESTIGATION_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192
AI_GROUNDING_STRICT=true

# ─── Connector OAuth (customer tenants grant these) ──────────────────────────
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI=http://localhost:3000/api/connectors/m365/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/gws/callback

# ─── Notification channels ───────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
RESEND_API_KEY=

# ─── Security ────────────────────────────────────────────────────────────────
# 32-byte base64 key used to envelope-encrypt per-tenant connector credentials.
TENANT_KEK_BASE64=
# Signs time-limited one-tap approval tokens delivered over WhatsApp/Slack.
APPROVAL_TOKEN_SECRET=
SESSION_SECRET=

# ─── Threat intelligence ─────────────────────────────────────────────────────
ABUSEIPDB_API_KEY=
OTX_API_KEY=
MAXMIND_LICENSE_KEY=
