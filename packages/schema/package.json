{
  "name": "@sentinel/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OCSF event types, case and signal contracts — generates Go structs",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "generate": "node scripts/generate-go.mjs",
    "generate:check": "node scripts/generate-go.mjs --check",
    "check-compat": "node scripts/check-compatibility.mjs",
    "check-compat:check": "node scripts/check-compatibility.mjs --check",
    "roundtrip-check": "node scripts/roundtrip-check.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
